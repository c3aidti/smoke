/**
* A single Smoke PPE output taken from a single [SimulationSample](type:SimulationSample)
*/
@db(index=['simulationRun', 'geoTimeGridPoint', 'dataset','flightTrack'],compactType=true)
entity type InterpFlightSimulationOutput
mixes DatasetSimulationOutputBase<InterpFlightSimulationDataset,SppeSimulationEnsembleRun,InterpFlightGeoTimeGrid>, ExCoeffSimulationOutputParameters 
schema name 'INTRP_FLT_OTP' {
    //
    flightTrack: FlightTrack
    // Add latitude to reconstruct GeoTimeGridPoint
    latitude: double
    // Add longitude to reconstruct GeoTimeGridPoint
    longitude: double
    // Add time to reconstruct GeoTimeGridPoint
    time: datetime
}