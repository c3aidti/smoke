type SimulationEnsembleRunInterpToFlightTracksJobOptions {
    // Filter for Simulation runs
    simulationFilter: Filter
    // Filter for {@link FlightTrack}(s)
    flightTrackFilter: Filter
    // hardware profile ID to run the batches
    hardwareProfileId: string = "appc8m642-w"
    // The type on which to call the method
    typeName: !string
    // the method to call in the batch job
    method: string = "upsertInterpOutputToFlightTracks"
    //
    datasetId: !string
    //
    batchSize: int = 4

}